# Copy to .env and edit locally. Do not commit .env.

CLB_NODE=claude
CLB_EMOJI=
CLB_CHAT_ID=123456789

CLB_TOKEN_FILE="$HOME/.config/claude-telegram-bridge/token.json"
CLB_TOKEN_REGISTRY="$HOME/.config/claude-telegram-bridge/token-registry.json"
CLB_STATE_DIR="$HOME/.local/state/claude-telegram-bridge"

# Default transport remains tmux. Native Windows ConPTY is experimental and
# opt-in; its foreground host launches Claude and cannot attach to an existing window.
CLB_REPL_TRANSPORT=tmux
# CLB_CONPTY_STATE_PATH=%LOCALAPPDATA%\claude-telegram-bridge\native-repl-host.json

CLB_TMUX_BIN=tmux
CLB_TMUX_SOCKET=default
CLB_TMUX_SESSION=claude

CLB_START_AT_END=1
CLB_TG_CHUNK=4096
CLB_TG_POLL_TIMEOUT=2
CLB_TYPING_MAX_SECONDS=7200

# Split a final-line <추천답변>...</추천답변> into a separate DM bubble.
SUGGESTED_REPLY_BUBBLE=1

# Let the bridge auto-send suggested replies marked class="auto-ok" after a
# cancel window, instead of only showing them. Off by default - read the
# "Suggested-reply auto-send" section in README.md before enabling.
# CLB_SUGGESTED_LOOP=1

# Release a previously observed Telegram turn when Claude is idle but no final
# reply was captured, so later queued messages can continue instead of being
# blocked behind a stale active turn.
CLB_ACTIVE_TURN_STALE_SECONDS=900

# Optional flow mirror: set 1/0 directly in this config. When unset, the bridge
# falls back to the runtime flag file below. Off by default (no env, no file).
CLB_FLOW_MIRROR=0
# Touch/remove this file for a live toggle when CLB_FLOW_MIRROR is unset.
CLB_FLOW_MIRROR_FLAG="$HOME/.config/claude-telegram-bridge/flow-mirror.on"

# Optional: command template for local voice/audio/video transcription.
# Use {path} as the downloaded media file path placeholder.
# CLB_AUDIO_TRANSCRIBE_CMD='python3 /path/to/transcribe.py {path}'
# CLB_AUDIO_TRANSCRIBE_TIMEOUT=600

# ---------------------------------------------------------------------------
# Advanced tuning (defaults shown; most setups never need to change these).
# <state_dir> below means CLB_STATE_DIR, <name> the per-node file prefix.

# Claude Code transcript directory the bridge watches for turn output.
# CLB_CLAUDE_PROJECTS_DIR=~/.claude/projects

# Startup self-update against PyPI (pip-managed installs only).
# CLB_NO_UPDATE_CHECK=0
# CLB_AUTO_UPDATE=0

# Token-registry ownership checks (multi-bridge machines).
# CLB_TOKEN_OWNER=claude-telegram-bridge
# CLB_EXPECTED_CONSUMER=<node>
# CLB_EXPECTED_HOST=<hostname>

# Prompt injection + transcript matching windows (seconds).
# CLB_INJECTION_VERIFY_TIMEOUT=20
# CLB_TRANSCRIPT_STABLE_SECONDS=1.0
# CLB_PENDING_TRANSCRIPT_SECONDS=300
# CLB_LATEST_TRANSCRIPT_FALLBACK_SECONDS=1800
# CLB_TURN_SEQUENCE_FALLBACK_SECONDS=7200

# Send retry policy.
# CLB_SEND_MAX_ATTEMPTS=3
# CLB_SEND_RETRY_SECONDS=5

# Composer clear retries before giving up on a dirty input box.
# CLB_COMPOSER_CLEAR_RETRIES=2

# Durable delivery state files and caps.
# CLB_QUEUE_PATH=<state_dir>/<name>.queue.jsonl
# CLB_QUEUE_COMPACT_MAX_EVENTS=5000
# CLB_OUTBOX_PATH=<state_dir>/<name>.outbox.json
# CLB_OUTBOX_MAX_ENTRIES=2000
# CLB_QUARANTINE_PATH=<state_dir>/<name>.quarantine.jsonl
# CLB_STATE_PATH=<state_dir>/<name>.state.json
# CLB_OFFSET_FILE=<state_dir>/<name>.offset
# CLB_POLL_HEARTBEAT_FILE=<state_dir>/<name>.poll-heartbeat
# CLB_PID_FILE=<state_dir>/<name>.pid

# Telegram-turn session binding.
# CLB_SESSION_TTL_SECONDS=86400
# CLB_SESSION_SIDECAR=<state_dir>/claude-telegram-bridge-sessions.json

# Per-turn egress ownership handshake with the Stop hook.
# CLB_EGRESS_SIDECAR=<state_dir>/claude-telegram-bridge-egress.json
# CLB_EGRESS_TTL_SECONDS=900

# Optional lifecycle watchdog script run after /exit-style session death.
# CLB_WATCHDOG_SCRIPT=~/.config/claude-telegram-bridge/watchdog.sh
